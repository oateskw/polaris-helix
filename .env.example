# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Required -------------------------------------------------------------
# Postgres (Neon) with pgvector. Must start with postgresql://; sslmode=require is enforced.
DATABASE_URL=postgresql://user:password@host/dbname
# Shared secret: inbound API auth, Telegram webhook secret, and outbound calls to the mesh.
# Letters, digits, "_" and "-" only (Telegram restriction). Same value on every agent.
# If unset, every authenticated endpoint returns 401.
HELIX_AUTH_TOKEN=

# Dedicated Telegram webhook secret (recommended). Falls back to HELIX_AUTH_TOKEN if empty.
# Letters, digits, "_" and "-" only. Re-run register_telegram_webhook.py after changing it.
TELEGRAM_WEBHOOK_SECRET=

# --- AI providers ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override for the prompt optimizer (default: claude-haiku-4-5)
ANTHROPIC_MODEL=
# Embeddings for semantic memory (text-embedding-3-small). Optional; memory is disabled without it.
OPENAI_API_KEY=

# --- Vendors --------------------------------------------------------------
MOLTSET_API_KEY=
PHANTOMBUSTER_API_KEY=
MYEMAILVERIFIER_API_KEY=
# Key for /api/v1/leads/status-update (falls back to HELIX_AUTH_TOKEN)
VANGUARD_API_KEY=
# Optional second database read by dashboard diagnostics
VANGUARD_DATABASE_URL=

# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Admin chat; commands from other chats are ignored
TELEGRAM_CHAT_ID=
# Optional: separate destinations for summaries and critical alerts
TELEGRAM_SUMMARY_CHAT_ID=
TELEGRAM_CRITICAL_BOT_TOKEN=
TELEGRAM_CRITICAL_CHAT_ID=

# --- Downstream agent URLs (defaults point at the Render deployments) -----
# CHIRON_API_URL=https://polaris-chiron.onrender.com
# NEXUS_NERVOUS_IMPULSE_URL=https://polaris-nexus.onrender.com
# NOVA_API_URL=https://polaris-nova.onrender.com
# BEACON_API_URL=https://polaris-beacon-agent.onrender.com
# RADAR_API_URL=https://polaris-radar.onrender.com
# PULSAR_API_URL=https://polaris-pulsar.onrender.com
# VANGUARD_API_URL=https://polaris-vanguard-core.onrender.com
# AURA_API_URL=https://polaris-aura.onrender.com

# --- Tuning (defaults shown) ----------------------------------------------
# HELIX_WATCHDOG_INTERVAL_SECONDS=300
# NOVA_STALE_RUN_MINUTES=120
# HELIX_SUMMARY_CATCHUP_ON_STARTUP=false
# HELIX_NOTIFICATION_DEDUPE_SECONDS=300
# HELIX_CRITICAL_REPEAT_COOLDOWN_SECONDS=900
# HELIX_NOTIFICATION_POLICY_MODE=strict
# NEXUS_MORNING_HOUR=6
# NOVA_DAILY_RESERVE_RATIO=0.10
# NOVA_EXPECTED_RECORDS_PER_DOMAIN=25
# NOVA_DEFAULT_RECORDS_PER_PEOPLE_QUERY=150
# NOVA_THRESHOLD_ALERT_DEBOUNCE_HOURS=6
# NOVA_BUDGET_DEFERRAL_ALERT_COOLDOWN_MINUTES=720
# CHIRON_OPTIMIZATION_COOLDOWN_HOURS=168
# TELEGRAM_MAX_COMMAND_AGE_SECONDS=900
# Workers to start: strategy (default), awareness, auditor, credit-sync, optimizer, summary, watchdog, or all
# HELIX_ENABLED_WORKERS=strategy
# HELIX_STRATEGY_REVIEW_ENABLED=true
# HELIX_STRATEGY_MIN_LEADS=30
# HELIX_STRATEGY_MAX_NEGATIVE_RATE=0.05
# Weekly briefs to Chiron (off until you turn it on; each one still needs /approve)
# HELIX_BRIEFS_ENABLED=false
# HELIX_BRIEFS_MIN_HARVEST=100
# HELIX_BRIEFS_MIN_REPLY_RATE=0.02
# HELIX_BRIEFS_MIN_BLUEPRINTS=1
# Read-only GitHub token used to check whether Chiron's pull requests are open or merged
# GITHUB_TOKEN=
# Put priority_score ahead of rotation order when picking targets (changes Nova rotation)
# HELIX_PRIORITY_FIRST_ORDERING=false
